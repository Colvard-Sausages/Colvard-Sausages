# Copy this file to `.env` and fill in your values.
# Get these from the QBO walkthrough (docs/qbo-connection-walkthrough.md).
# NEVER commit your real .env — it's already in .gitignore.

# From the Intuit Developer app → Keys & credentials → Development tab
QBO_CLIENT_ID=your_development_client_id_here
QBO_CLIENT_SECRET=your_development_client_secret_here

# From the OAuth Playground (the RT1-... value and the 16-17 digit realm)
QBO_REFRESH_TOKEN=your_refresh_token_here
QBO_REALM_ID=your_realm_id_here

# 'sandbox' while testing; 'production' once your real QBO app is approved
QBO_ENVIRONMENT=sandbox

# Where your dashboard database lives. For a fresh test, leave as-is and a new
# file is created. To wire into your real dashboards, point this at the real
# master.db that the other 24 dashboards already use.
COLVARD_DB_PATH=master.db

# Optional: only set this if you configured a QBO webhook (step 6).
# QBO_WEBHOOK_VERIFIER_TOKEN=your_webhook_verifier_token_here
