# Serves the invoices page + API on :8765 (alternative to Docker).
# Install:
#   sudo cp deploy/colvard-web.service /etc/systemd/system/
#   sudo systemctl enable --now colvard-web.service
[Unit]
Description=Colvard invoices dashboard (web + API)
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/colvard/qbo.env
WorkingDirectory=/opt/Colvard-Sausages
ExecStart=/usr/bin/python3 -m uvicorn api.invoices_api:app --host 0.0.0.0 --port 8765
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
